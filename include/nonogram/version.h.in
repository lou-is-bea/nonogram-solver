/**
 * @file version.h
 * @brief Library version, following semantic versioning.
 *
 * Generated by CMake from version.h.in: edit the project() version in the root
 * CMakeLists.txt, never the generated file.
 */
#ifndef NG_NONOGRAM_VERSION_H
#define NG_NONOGRAM_VERSION_H

#include <stdint.h>

/** @brief Major version: incremented on incompatible API changes. */
constexpr uint32_t NG_VERSION_MAJOR = @PROJECT_VERSION_MAJOR@;
/** @brief Minor version: incremented on backward-compatible additions. */
constexpr uint32_t NG_VERSION_MINOR = @PROJECT_VERSION_MINOR@;
/** @brief Patch version: incremented on backward-compatible fixes. */
constexpr uint32_t NG_VERSION_PATCH = @PROJECT_VERSION_PATCH@;

/**
 * @brief Return the library version as "MAJOR.MINOR.PATCH".
 *
 * Lets a program detect a mismatch between the headers it was compiled with and the library
 * it is linked against.
 *
 * @return A static, nul-terminated string. Never nullptr.
 * @ownership The string is owned by the library and must not be freed or modified.
 * @complexity O(1) time and memory.
 */
const char *ng_version_string(void);

#endif /* NG_NONOGRAM_VERSION_H */
