{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc-14" }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-20" }
    },
    {
      "name": "dev",
      "displayName": "Debug, GCC 14, strict warnings",
      "inherits": "gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "dev-clang",
      "displayName": "Debug, Clang 20, strict warnings",
      "inherits": "clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release, GCC 14",
      "inherits": "gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + LeakSanitizer, Clang 20",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer (+ integer), Clang 20",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=undefined,integer -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined,integer"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage instrumentation, GCC 14",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "--coverage -O0",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets, Clang 20",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "NG_BUILD_TESTS": "OFF",
        "NG_BUILD_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "dev-clang", "configurePreset": "dev-clang" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "ignore" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "dev-clang", "inherits": "base", "configurePreset": "dev-clang" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "configurePreset": "ubsan",
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1" }
    },
    { "name": "coverage", "inherits": "base", "configurePreset": "coverage" }
  ]
}
